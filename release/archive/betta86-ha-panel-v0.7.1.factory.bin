 тЅЅesp_littlefs␀␀␀␀lfs_fs_grow_␀␀␀␀lfs_dir_open␀␀␀␀lfs_file_truncate_␀␀lfs_file_truncate␀␀␀lfs_file_seek␀␀␀lfs_file_write_␀lfs_file_write␀␀lfs_file_read_␀␀lfs_file_read␀␀␀lfs_file_sync␀␀␀lfs_file_close␀␀lfs_file_opencfg␀␀␀␀lfs_rename_␀lfs_fs_demove␀␀␀lfs_remove_␀lfs_dir_compact␀lfs_bd_sync␀lfs_dir_traverse␀␀␀␀lfs_dir_relocatingcommit␀␀␀␀lfs_fs_preporphans␀␀lfs_bd_flush␀␀␀␀lfs_bd_prog␀lfs_bd_erase␀␀␀␀lfs_dir_orphaningcommit␀lfs_bd_read␀lfs_dir_getslice␀␀␀␀lfs_init␀␀␀␀lfs_format_␀яяяяяяяя␀␀␀␀␀␀<!-- SPDX-License-Identifier: LicenseRef-FNCL-1.1 | Copyright (c) 2026 Cpt_Kirk -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BETTA HA Panel - BETTA Editor</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div id="provisioningRoot" class="provisioning-shell hidden">
    <div class="provisioning-card">
      <div id="provisioningWifiPage" class="provisioning-page hidden">
        <h1 id="provWifiTitle">Wi-Fi Provisioning</h1>
        <p id="provWifiSubtitle" class="provisioning-subtitle">Connect the panel to your Wi-Fi.</p>
        <label><span id="provWifiSsidLabel">SSID</span>
          <input id="provWifiSsid" type="text" placeholder="MyWiFi" maxlength="32" />
        </label>
        <label><span id="provWifiCountryCodeLabel">Country Code</span>
          <input id="provWifiCountryCode" type="text" list="wifiCountryCodeList" placeholder="US" maxlength="2" />
        </label>
        <div class="row">
          <button id="provScanWifiBtn" class="btn small" type="button">Scan</button>
          <select id="provWifiScanResults">
            <option value="">No scan yet</option>
          </select>
        </div>
        <div id="provWifiScanInfo" class="meta">Click "Scan" to list nearby networks.</div>
        <label><span id="provWifiPasswordLabel">Password</span>
          <input id="provWifiPassword" type="password" placeholder="Wi-Fi password" maxlength="64" />
        </label>
        <label class="row row-inline">
          <input id="provWifiShowPassword" type="checkbox" />
          <span id="provWifiShowPasswordLabel">Show password</span>
        </label>
        <div id="provWifiInfo" class="meta"></div>
        <button id="provWifiSaveBtn" class="btn primary" type="button">Save + Reboot</button>
      </div>

      <div id="provisioningHaPage" class="provisioning-page hidden">
        <h1 id="provHaTitle">HA Provisioning</h1>
        <p id="provHaSubtitle" class="provisioning-subtitle">Connect the panel to Home Assistant.</p>
        <label><span id="provHaUrlLabel">WebSocket URL (ws:// or wss://)</span>
          <input id="provHaUrl" type="text" placeholder="ws://homeassistant.local:8123/api/websocket" maxlength="255" />
        </label>
        <label><span id="provHaTokenLabel">Long-lived Access Token</span>
          <input id="provHaToken" type="password" placeholder="Home Assistant Token" maxlength="511" />
        </label>
        <label class="row row-inline">
          <input id="provHaShowToken" type="checkbox" />
          <span id="provHaShowTokenLabel">Show token</span>
        </label>
        <div id="provHaInfo" class="meta"></div>
        <button id="provHaSaveBtn" class="btn primary" type="button">Save + Reboot</button>
      </div>
    </div>
  </div>

  <div id="editorShell" class="shell">
    <aside class="sidebar">
      <header class="sidebar-header">
        <h1 id="sidebarTitle"><span id="sidebarTitleText">BETTA Editor</span><small id="appVersionLabel" class="app-version"></small></h1>
        <p id="sidebarSubtitle">Layout source of truth: JSON</p>
      </header>

      <div class="mode-tabs">
        <button id="layoutTabBtn" class="btn tab active">Layout</button>
        <button id="settingsTabBtn" class="btn tab">Settings</button>
      </div>

      <div id="layoutPane" class="pane">
        <section id="pagesSection" class="panel-section collapsible">
          <div class="section-head">
            <h2 id="pagesHeading">Pages</h2>
            <div class="row">
              <button id="addPageBtn" class="btn small">+ Page</button>
              <button id="deletePageBtn" class="btn small danger">Delete</button>
              <button id="togglePagesSection" class="btn small collapse-toggle" type="button" aria-expanded="true"
                aria-controls="pagesSectionBody">-</button>
            </div>
          </div>
          <div id="pagesSectionBody" class="section-body">
            <ul id="pagesList" class="list"></ul>
            <div class="form" style="margin-top: 8px;">
              <label><span id="pageTitleLabel">Page title</span>
                <input id="pageTitleInput" type="text" placeholder="Page name on the display" />
              </label>
              <button id="applyPageBtn" class="btn">Apply page title</button>
            </div>
          </div>
          <div id="pagesMiniList" class="section-mini"></div>
        </section>

        <section id="widgetsSection" class="panel-section collapsible">
          <div class="section-head">
            <h2 id="widgetsHeading">Widgets</h2>
            <button id="toggleWidgetsSection" class="btn small collapse-toggle" type="button" aria-expanded="true"
              aria-controls="widgetsSectionBody">-</button>
          </div>
          <div id="widgetsSectionBody" class="section-body">
            <div class="row">
              <button id="openSetupWizardBtn" class="btn small primary" type="button">Quick Setup</button>
              <button id="addSensorBtn" class="btn small">+ Sensor</button>
              <button id="addButtonBtn" class="btn small">+ Button</button>
              <button id="addSliderBtn" class="btn small">+ Slider</button>
              <button id="addGraphBtn" class="btn small">+ Graph</button>
              <button id="addEmptyTileBtn" class="btn small">+ Empty Tile</button>
              <button id="addLightTileBtn" class="btn small">+ Light Tile</button>
              <button id="addHeatingTileBtn" class="btn small">+ Heating Tile</button>
              <button id="addWeatherTileBtn" class="btn small">+ Weather</button>
              <button id="addWeather3DayBtn" class="btn small">+ Weather 3-day</button>
            </div>
            <ul id="widgetsList" class="list"></ul>
            <button id="deleteWidgetBtn" class="btn danger">Delete Widget</button>
          </div>
        </section>

        <section id="inspectorSection" class="panel-section collapsible">
          <div class="section-head">
            <h2 id="inspectorHeading">Inspector</h2>
            <button id="toggleInspectorSection" class="btn small collapse-toggle" type="button" aria-expanded="true"
              aria-controls="inspectorSectionBody">-</button>
          </div>
          <div id="inspectorSectionBody" class="section-body">
            <div class="form">
              <label><span id="fTitleLabel">Title</span> <input id="fTitle" type="text" /></label>
              <select id="fType" hidden>
                <option value="sensor">sensor</option>
                <option value="button">button</option>
                <option value="slider">slider</option>
                <option value="graph">graph</option>
                <option value="empty_tile">empty_tile</option>
                <option value="light_tile">light_tile</option>
                <option value="heating_tile">heating_tile</option>
                <option value="weather_tile">weather_tile</option>
                <option value="weather_3day">weather_3day</option>
              </select>
              <label id="fEntityWrap"><span id="fEntityLabel">Entity</span>
                <input id="fEntity" type="text" list="entityOptions" />
                <datalist id="entityOptions"></datalist>
              </label>
              <label id="fSecondaryEntityWrap" class="hidden"><span id="fSecondaryEntityLabel">Actual entity (sensor)</span>
                <input id="fSecondaryEntity" type="text" list="sensorEntityOptions" />
                <datalist id="sensorEntityOptions"></datalist>
              </label>
              <div id="buttonOptions" class="slider-options hidden">
                <label><span id="fButtonModeLabel">Button mode</span>
                  <select id="fButtonMode">
                    <option value="auto">auto (default switch)</option>
                    <option value="play_pause">play/pause (media_player)</option>
                    <option value="stop">stop (media_player)</option>
                    <option value="next">next (media_player)</option>
                    <option value="previous">previous (media_player)</option>
                  </select>
                </label>
                <label><span id="fButtonAccentColorLabel">Button accent color</span>
                  <input id="fButtonAccentColor" type="color" value="#6fe8ff" />
                </label>
              </div>
              <div id="sliderOptions" class="slider-options hidden">
                <label><span id="fSliderEntityDomainLabel">Slider entity type</span>
                  <select id="fSliderEntityDomain">
                    <option value="auto">auto (light, media_player, cover)</option>
                    <option value="light">light</option>
                    <option value="media_player">media_player</option>
                    <option value="cover">cover</option>
                  </select>
                </label>
                <label><span id="fSliderDirectionLabel">Slider direction</span>
                  <select id="fSliderDirection">
                    <option value="auto">auto (width/height based)</option>
                    <option value="left_to_right">left_to_right (0% -> 100%)</option>
                    <option value="right_to_left">right_to_left (100% -> 0%)</option>
                    <option value="bottom_to_top">bottom_to_top (0% -> 100%)</option>
                    <option value="top_to_bottom">top_to_bottom (100% -> 0%)</option>
                  </select>
                </label>
                <label><span id="fSliderAccentColorLabel">Slider accent color</span>
                  <input id="fSliderAccentColor" type="color" value="#6fe8ff" />
                </label>
              </div>
              <div id="graphOptions" class="slider-options hidden">
                <label><span id="fGraphLineColorLabel">Graph line color</span>
                  <input id="fGraphLineColor" type="color" value="#6fe8ff" />
                </label>
                <label><span id="fGraphTimeWindowMinLabel">Time window (minutes)</span>
                  <input id="fGraphTimeWindowMin" type="number" min="1" max="1440" step="1" value="120" />
                </label>
                <label><span id="fGraphPointCountLabel">Render points (empty = auto)</span>
                  <input id="fGraphPointCount" type="number" min="16" max="64" step="1" placeholder="auto" />
                </label>
              </div>
              <div class="grid-2">
                <label>X <input id="fX" type="number" /></label>
                <label>Y <input id="fY" type="number" /></label>
                <label>W <input id="fW" type="number" /></label>
                <label>H <input id="fH" type="number" /></label>
              </div>
              <button id="applyInspectorBtn" class="btn hidden" type="button" hidden>Apply</button>
            </div>
          </div>
        </section>
      </div>

      <div id="settingsPane" class="pane hidden">
        <section>
          <h2 id="settingsWifiHeading">Wi-Fi</h2>
          <div class="form">
            <label><span id="settingsWifiSsidLabel">SSID</span>
              <input id="settingsWifiSsid" type="text" placeholder="MyWiFi" maxlength="32" />
            </label>
            <label><span id="settingsWifiCountryCodeLabel">Country Code</span>
              <input id="settingsWifiCountryCode" type="text" list="wifiCountryCodeList" placeholder="US" maxlength="2" />
            </label>
            <label><span id="settingsWifiBssidLabel">BSSID Lock (optional)</span>
              <input id="settingsWifiBssid" type="text" placeholder="AA:BB:CC:DD:EE:FF" maxlength="17" />
            </label>
            <div class="row">
              <button id="scanWifiBtn" class="btn small" type="button">Scan Wi-Fi</button>
              <select id="settingsWifiScanResults">
                <option value="">No scan yet</option>
              </select>
            </div>
            <div id="settingsWifiScanInfo" class="meta">Click "Scan Wi-Fi" to list nearby networks.</div>
            <label><span id="settingsWifiPasswordLabel">Password</span>
              <input id="settingsWifiPassword" type="password" placeholder="Leave empty to keep the stored password" maxlength="64" />
            </label>
            <div id="settingsWifiInfo" class="meta"></div>
          </div>
        </section>

        <section>
          <h2 id="settingsHaHeading">Home Assistant</h2>
          <div class="form">
            <label><span id="settingsHaUrlLabel">WebSocket URL (ws:// or wss://)</span>
              <input id="settingsHaUrl" type="text" placeholder="wss://homeassistant.local:8123/api/websocket" maxlength="255" />
            </label>
            <label><span id="settingsHaTokenLabel">Long-lived Access Token</span>
              <textarea id="settingsHaToken" placeholder="Leave empty to keep the stored token" maxlength="511"></textarea>
            </label>
            <label class="row">
              <input id="settingsHaRestEnabled" type="checkbox" />
              <span id="settingsHaRestEnabledLabel">Enable HA REST fallback (Default: Off, WS-only preferred)</span>
            </label>
            <div id="settingsHaInfo" class="meta"></div>
          </div>
        </section>

        <section>
          <h2 id="settingsTimeHeading">Time</h2>
          <div class="form">
            <label><span id="settingsNtpServerLabel">NTP Server</span>
              <input id="settingsNtpServer" type="text" placeholder="pool.ntp.org" maxlength="127" />
            </label>
            <label><span id="settingsTimezoneLabel">Timezone (POSIX TZ)</span>
              <input id="settingsTimezone" type="text" placeholder="CET-1CEST,M3.5.0/2,M10.5.0/3" maxlength="127" />
            </label>
            <div id="settingsTimeInfo" class="meta"></div>
          </div>
        </section>

        <section>
          <h2 id="settingsUiHeading">UI</h2>
          <div class="form">
            <label><span id="settingsLanguageLabel">Language</span>
              <select id="settingsLanguage"></select>
            </label>
            <div id="settingsUiInfo" class="meta"></div>
            <div class="row">
              <button id="reloadLanguagesBtn" class="btn small" type="button">Reload Languages</button>
              <button id="downloadLanguageBtn" class="btn small" type="button">Download JSON</button>
            </div>
            <label><span id="uploadLanguageCodeLabel">Language Code</span>
              <input id="uploadLanguageCode" type="text" maxlength="15" placeholder="fr" />
            </label>
            <label><span id="uploadLanguageFileLabel">Translation JSON File</span>
              <input id="uploadLanguageFile" type="file" accept="application/json,.json" />
            </label>
            <button id="uploadLanguageBtn" class="btn" type="button">Upload / Add Language</button>
            <div id="settingsTranslationInfo" class="meta"></div>
          </div>
        </section>

        <section>
          <h2 id="settingsApHeading">Setup AP</h2>
          <div id="settingsApInfo" class="meta"></div>
          <div id="settingsApHint" class="meta">If setup AP is active, connect to it and open <code>http://192.168.4.1</code>.</div>
        </section>

        <section>
          <h2 id="settingsOtaHeading">Firmware Update</h2>
          <div class="form">
            <label><span id="settingsOtaUrlLabel">OTA URL</span>
              <input id="settingsOtaUrl" type="url" placeholder="https://github.com/.../release/betta86-ha-panel-v0.7.ota.bin" maxlength="511" />
            </label>
            <div class="row">
              <button id="startOtaUrlBtn" class="btn small" type="button">Flash URL</button>
              <button id="refreshOtaStatusBtn" class="btn small" type="button">Refresh Status</button>
            </div>
            <label><span id="settingsOtaFileLabel">OTA .bin File</span>
              <input id="settingsOtaFile" type="file" accept=".bin,application/octet-stream" />
            </label>
            <button id="uploadOtaBtn" class="btn" type="button">Upload + Flash</button>
            <div class="ota-progress" aria-hidden="true">
              <div id="settingsOtaProgressBar" class="ota-progress-bar"></div>
            </div>
            <div id="settingsOtaInfo" class="meta"></div>
          </div>
        </section>

        <section>
          <h2 id="settingsActionsHeading">Settings Actions</h2>
          <div class="row">
            <button id="reloadSettingsBtn" class="btn">Reload Settings</button>
            <button id="saveSettingsBtn" class="btn primary">Save + Reboot</button>
          </div>
          <div id="settingsActionsHint" class="meta">After save, the device reboots and may switch from setup AP to your home Wi-Fi.</div>
        </section>
      </div>
    </aside>

    <main class="workspace">
      <div class="workspace-top">
        <h2 id="canvasTitle">Canvas</h2>
        <div id="status" class="status">Idle</div>
      </div>
      <div class="workspace-body">
        <div class="canvas-wrap">
          <div id="canvas" class="canvas"></div>
        </div>
        <aside class="actions-panel">
          <section class="panel-section">
            <h2 id="layoutActionsHeading">Actions</h2>
            <div class="row">
              <button id="reloadBtn" class="btn">Reload</button>
              <button id="saveBtn" class="btn primary">Save</button>
              <button id="exportBtn" class="btn">Export</button>
            </div>
            <div class="row">
              <button id="importBtn" class="btn">Import JSON</button>
              <input id="importFile" type="file" accept="application/json" />
            </div>
            <textarea id="jsonPaste" placeholder="Paste layout JSON here"></textarea>
          </section>
        </aside>
      </div>
    </main>
  </div>
  <div id="lightEntityPickerOverlay" class="modal-overlay hidden">
    <div class="modal-card light-picker-dialog">
      <div class="section-head">
        <h2 id="lightEntityPickerTitle">Choose Light</h2>
        <div class="row">
          <button id="lightEntityPickerRefreshBtn" class="btn small" type="button">Refresh</button>
          <button id="lightEntityPickerCloseBtn" class="btn small" type="button">X</button>
        </div>
      </div>
      <input id="lightEntityPickerSearch" class="light-picker-search" type="search" placeholder="Search entities" maxlength="63" />
      <div id="lightEntityPickerStatus" class="meta"></div>
      <div id="lightEntityPickerProgress" class="entity-picker-progress hidden" aria-hidden="true">
        <div class="entity-picker-progress-track">
          <div id="lightEntityPickerProgressBar" class="entity-picker-progress-bar"></div>
        </div>
        <span id="lightEntityPickerProgressText" class="meta"></span>
      </div>
      <div id="lightEntityPickerRooms" class="light-picker-rooms"></div>
      <div class="row">
        <button id="lightEntityPickerBlankBtn" class="btn small" type="button">Blank Light Tile</button>
      </div>
    </div>
  </div>
  <div id="setupWizardOverlay" class="modal-overlay setup-wizard-overlay hidden">
    <div class="modal-card setup-wizard-dialog">
      <div class="section-head">
        <h2 id="setupWizardTitle">Quick Setup</h2>
        <button id="setupWizardCloseBtn" class="btn small" type="button">Close</button>
      </div>
      <div class="setup-wizard-steps" aria-hidden="true">
        <span id="setupWizardStepHa" class="setup-wizard-step done">HA connected</span>
        <span id="setupWizardStepTiles" class="setup-wizard-step active">Add tiles</span>
        <span id="setupWizardStepSave" class="setup-wizard-step">Save layout</span>
      </div>
      <p id="setupWizardSubtitle" class="meta">Pick a few Home Assistant entities for your first dashboard.</p>
      <label><span id="setupWizardPageLabel">First page title</span>
        <input id="setupWizardPageTitle" type="text" placeholder="Living Room" maxlength="31" />
      </label>
      <div class="setup-wizard-actions-grid">
        <button id="setupWizardAddLightBtn" class="btn setup-widget-btn" type="button">+ Light</button>
        <button id="setupWizardAddHeatingBtn" class="btn setup-widget-btn" type="button">+ Heating</button>
        <button id="setupWizardAddWeatherBtn" class="btn setup-widget-btn" type="button">+ Weather</button>
        <button id="setupWizardAddButtonBtn" class="btn setup-widget-btn" type="button">+ Switch</button>
        <button id="setupWizardAddSensorBtn" class="btn setup-widget-btn" type="button">+ Sensor</button>
      </div>
      <div id="setupWizardCount" class="setup-wizard-count">No tiles added yet.</div>
      <div id="setupWizardStatus" class="meta"></div>
      <div class="row setup-wizard-footer">
        <button id="setupWizardSkipBtn" class="btn" type="button">Skip</button>
        <button id="setupWizardSaveBtn" class="btn primary" type="button">Save Layout</button>
        <button id="setupWizardDoneBtn" class="btn" type="button">Save + Done</button>
      </div>
    </div>
  </div>
  <datalist id="wifiCountryCodeList">
    <option value="US"></option>
    <option value="DE"></option>
    <option value="AT"></option>
    <option value="CH"></option>
    <option value="NL"></option>
    <option value="FR"></option>
    <option value="IT"></option>
    <option value="ES"></option>
    <option value="GB"></option>
    <option value="PL"></option>
    <option value="SE"></option>
    <option value="NO"></option>
    <option value="DK"></option>
    <option value="FI"></option>
    <option value="CZ"></option>
    <option value="PT"></option>
    <option value="IE"></option>
    <option value="BE"></option>
    <option value="JP"></option>
    <option value="CN"></option>
    <option value="KR"></option>
    <option value="AU"></option>
    <option value="CA"></option>
  </datalist>
  <script src="/app.js"></script>
</body>
</html>
